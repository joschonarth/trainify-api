# Node Environment
NODE_ENV=dev

# Auth
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-chars
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Number of trusted reverse-proxy hops in front of the API
TRUST_PROXY_HOPS=1

# Database
DATABASE_URL="postgresql://docker:docker@localhost:5432/trainify?schema=public"

# Outbox worker. Enable only with a disposable database and broker until cutover.
OUTBOX_PUBLISHER_ENABLED=false
RABBITMQ_URL=amqp://trainify_local:trainify_local@127.0.0.1:5672/trainify
OUTBOX_HEALTH_PORT=3334
OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_MS=1000
OUTBOX_CONFIRM_TIMEOUT_MS=5000
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_RETRY_MS=60000
OUTBOX_SHUTDOWN_MS=15000
OUTBOX_BACKLOG_WARN_MS=300000

# RabbitMQ consumer for workout rewards (streaks and badges)
GAMIFICATION_CONSUMER_ENABLED=false
GAMIFICATION_CONSUMER_PREFETCH=10
GAMIFICATION_CONSUMER_LEASE_MS=30000
GAMIFICATION_CONSUMER_RETRY_MS=5000
GAMIFICATION_CONSUMER_MAX_ATTEMPTS=5

# Badge outbox publisher and its independent batch size
BADGE_OUTBOX_PUBLISHER_ENABLED=false
BADGE_OUTBOX_BATCH_SIZE=20

# RabbitMQ consumer for in-app badge notifications. Retries wait in milliseconds before the next attempt.
BADGE_NOTIFICATIONS_CONSUMER_ENABLED=false
BADGE_NOTIFICATIONS_PREFETCH=10
BADGE_NOTIFICATIONS_RETRY_MS=5000
BADGE_NOTIFICATIONS_MAX_ATTEMPTS=5

# Optional Compose overrides for disposable services.
# RABBITMQ_LOCAL_USER=trainify_local
# RABBITMQ_LOCAL_PASSWORD=trainify_local
# OUTBOX_RABBITMQ_URL=amqp://trainify_local:trainify_local@trainify-rabbitmq:5672/trainify
# OUTBOX_DATABASE_URL=postgresql://docker:docker@trainify-pg:5432/trainify_outbox_validation?schema=public
