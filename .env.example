# Node Environment
NODE_ENV=dev

# Auth
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-chars
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Number of trusted reverse-proxy hops in front of the API
TRUST_PROXY_HOPS=1

# Database
DATABASE_URL="postgresql://docker:docker@localhost:5432/trainify?schema=public"