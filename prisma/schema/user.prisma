enum UserRole {
  USER
  ADMIN
}

model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  password     String?
  tokenVersion Int     @default(0) @map("token_version")
  role         UserRole @default(USER) @map("role")
  avatarUrl    String?
  timezone     String  @default("America/Sao_Paulo")

  height    Int?
  weight    Float?
  gender    String?
  birthdate DateTime?

  createdAt DateTime @default(now()) @map("created_at")

  exercise    Exercise[]
  myExercise  MyExercise[]
  exerciseLog ExerciseLog[]
  workout     Workout[]
  sessions    WorkoutSession[]
  dailySessions DailyWorkoutSession[]

  streak UserStreak?
  streakTracking StreakTracking?

  WeightGoal       WeightGoal[]
  WeightLog        WeightLog[]
  UserBadge        UserBadge[]
  UserStreakLog    UserStreakLog[]
  workoutSchedules WorkoutSchedule[]
  notifications    Notification[]

  @@map("users")
}
