model StreakTracking {
  userId String @id
  timezone String
  activationDate String @db.VarChar(10)
  user User @relation(fields: [userId], references: [id])
  versions StreakPlan[]
  @@map("streak_tracking")
}

model StreakPlan {
  userId String
  effectiveDate String @db.VarChar(10)
  workouts Json
  tracking StreakTracking @relation(fields: [userId], references: [userId])
  @@id([userId, effectiveDate])
  @@map("streak_plans")
}

model UserStreak {
  id            String    @id @default(cuid())
  userId        String    @unique
  currentStreak Int       @default(0)
  bestStreak    Int       @default(0)
  lastBusinessDate String? @db.VarChar(10)
  lastWorkout   DateTime?
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("streaks")
}

model UserStreakLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  businessDate String? @db.VarChar(10)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@unique([userId, businessDate])
  @@map("user_streak_logs")
}
