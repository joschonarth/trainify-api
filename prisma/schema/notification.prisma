enum NotificationType {
  BADGE_UNLOCKED
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  eventId     String           @db.Uuid
  type        NotificationType
  data        Json
  createdAt   DateTime         @default(now())
  readAt      DateTime?
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, eventId])
  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([recipientId, readAt, createdAt(sort: Desc), id(sort: Desc)])
  @@map("notifications")
}

model BadgeNotificationDelivery {
  eventId       String   @id @db.Uuid
  attempts      Int
  attemptToken  String   @db.Uuid
  nextAttemptAt DateTime
  failure       String?

  @@map("badge_notification_deliveries")
}

model BadgeNotificationReplay {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @db.Uuid
  operator  String
  reason    String
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
  @@map("badge_notification_replays")
}
