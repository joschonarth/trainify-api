enum WorkoutSessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  INCOMPLETE
  SKIPPED
}

model WorkoutSession {
  id     String               @id @default(cuid())
  date   DateTime             @default(now())
  status WorkoutSessionStatus @default(PENDING)

  startedAt DateTime? @map("started_at")
  endedAt   DateTime? @map("ended_at")
  duration  Int?

  userId    String
  workoutId String

  user             User              @relation(fields: [userId], references: [id])
  workout          Workout           @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseSessions ExerciseSession[]
  dailyIdentity    DailyWorkoutSession?
  completion       WorkoutSessionCompletion?

  @@index([userId, date])
  @@map("workout_sessions")
}

model WorkoutSessionCompletion {
  sessionId   String   @id
  completedAt DateTime
  hasActivity Boolean
  businessDate String? @db.VarChar(10)
  timezone String?

  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("workout_session_completions")
}

model DailyWorkoutSession {
  userId       String
  businessDate String @db.VarChar(10)
  timezone     String
  sessionId    String @unique

  user    User           @relation(fields: [userId], references: [id])
  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([userId, businessDate])
  @@map("daily_workout_sessions")
}

model ExerciseSession {
  id        String  @id @default(cuid())
  completed Boolean @default(false)
  position  Int     @default(0)

  plannedSets   Int?
  plannedReps   Int?
  plannedWeight Float?
  skipReason    String? @map("skip_reason") @db.VarChar(255)

  startedAt DateTime? @map("started_at")
  endedAt   DateTime? @map("ended_at")
  duration  Int?

  workoutSessionId String
  exerciseId       String

  workoutSession WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exercise       Exercise       @relation(fields: [exerciseId], references: [id])
  logs           ExerciseLog[]

  @@unique([workoutSessionId, exerciseId])
  @@index([exerciseId])
  @@map("exercise_sessions")
}

model ExerciseLog {
  id          String   @id @default(cuid())
  sets        Int
  reps        Int
  weight      Float?
  volume      Float
  description String?
  date        DateTime @default(now())

  exerciseSessionId String
  userId            String
  exerciseId        String

  exerciseSession ExerciseSession @relation(fields: [exerciseSessionId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id])
  exercise        Exercise        @relation(fields: [exerciseId], references: [id])

  @@index([userId, exerciseId, date])
  @@map("exercise_logs")
}
